{
  "name": "trendsfast-cli",
  "version": "0.1.0",
  "description": "The trendsfast command for AI coding agents: installs the TrendsFast skill, signs in through the browser and runs source-backed market research (customers, trending, competitors, formats, search) with quoted, idempotent paid calls.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://trendsfast.com/docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/meestierolff/trendsfast-open.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://trendsfast.com/support"
  },
  "author": {
    "name": "TrendsFast",
    "url": "https://trendsfast.com"
  },
  "keywords": [
    "trendsfast",
    "cli",
    "agent-skills",
    "claude-code",
    "codex",
    "cursor",
    "market-research",
    "trends"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "trendsfast": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "node scripts/prepare-build.mjs && tsc -p tsconfig.json && node scripts/finish-build.mjs",
    "test": "npm run build && node --test --test-concurrency=1 \"test/**/*.test.mjs\"",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  }
}
