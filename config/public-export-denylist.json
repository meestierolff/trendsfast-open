{
  "version": 1,
  "defaultDecision": "deny",
  "deniedCapabilities": [
    "managed-provider-adapters",
    "dataforseo-implementation",
    "scrapecreators-implementation",
    "production-query-generation",
    "source-routing",
    "source-lookback-policy",
    "ranking-weights",
    "numeric-quality-thresholds",
    "production-prompts",
